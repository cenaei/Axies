{
  "name": "axies-nft-marketplace",
  "version": "2.0.0",
  "description": "Modern, accessible Web3 NFT Marketplace landing platform",
  "scripts": {
    "build:css": "sass assets/sass/main.scss assets/css/main.css --no-source-map",
    "build:js": "esbuild src/js/main.js --bundle --outfile=app.js --format=iife",
    "build": "npm run build:css && npm run build:js",
    "dev": "npm run build",
    "serve": "npx serve ."
  },
  "keywords": [
    "nft-marketplace",
    "web3",
    "design-tokens",
    "accessibility",
    "wcag-compliant",
    "dark-mode",
    "vanilla-js"
  ],
  "author": "Sina Sangiji",
  "license": "MIT"
}
